# Example environment configuration for School Management System
# Copy this file to .env and adjust variables as needed.

# Security
# In production (DEBUG=False), DJANGO_SECRET_KEY must be a random, secret string.
DJANGO_SECRET_KEY=change-me-to-a-secure-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=school.example.com,www.school.example.com

# Database (PostgreSQL recommended for production)
DJANGO_DATABASE_ENGINE=postgresql
DJANGO_DATABASE_NAME=school_db
DJANGO_DATABASE_USER=postgres
DJANGO_DATABASE_PASSWORD=your_secure_db_password
DJANGO_DATABASE_HOST=localhost
DJANGO_DATABASE_PORT=5432

# Or for local SQLite development:
# DJANGO_DATABASE_ENGINE=sqlite3
# DJANGO_DATABASE_PATH=db.sqlite3

# Email (for password resets and notifications)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=notifications@school.example.com
DJANGO_EMAIL_HOST_PASSWORD=your_email_password
DJANGO_EMAIL_USE_TLS=True
DJANGO_DEFAULT_FROM_EMAIL="School Management System <noreply@school.example.com>"

# HTTPS & Cookie Security (Defaults to True in production)
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000

# Private media acceleration (Set True if using Nginx X-Accel-Redirect)
DJANGO_USE_X_ACCEL_REDIRECT=False
